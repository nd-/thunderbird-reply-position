{
  "name": "reply-position",
  "version": "1.0.0",
  "scripts": {
    "build": "web-ext build -s src -a web-ext-artifacts --overwrite-dest --filename \"reply-position-{version}.xpi\"",
    "capture": "node tools/run-integration.mjs",
    "fixtures": "node tools/extract-fixtures.mjs",
    "lint": "web-ext lint -s src",
    "profile": "node tools/make-profile.mjs",
    "test": "node --test test/*.test.js",
    "verify": "node tools/run-integration.mjs --verify"
  },
  "license": "MPL-2.0",
  "private": "true",
  "type": "module",
  "devDependencies": {
    "jsdom": "^28.1.0",
    "web-ext": "^10.6.0"
  }
}
